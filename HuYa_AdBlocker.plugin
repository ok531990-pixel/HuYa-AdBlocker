#!name=HuYa 去广告
#!desc=虎牙 APP 去广告 v3.1：域拦截（虎牙广告域+欢聚上报+广点通/MediaV SDK+开屏素材域）+ URL Rewrite（wup HTTPDNS 广告/开屏素材）。SSL Pinning 域走 DNS 拒绝，可解密域走 Rewrite，双保险。
#!home=https://github.com/ok531990-pixel/HuYa-AdBlocker
#!version=3.1.0

[Rule]
# ═══ 虎牙专属广告/统计域（只影响虎牙，必开）═══
DOMAIN-SUFFIX,ad.huya.com,REJECT
DOMAIN-SUFFIX,ads.huya.com,REJECT
DOMAIN-SUFFIX,df.huya.com,REJECT
DOMAIN-SUFFIX,e-ad-monitor.huya.com,REJECT
DOMAIN-SUFFIX,e-stat.huya.com,REJECT
DOMAIN-SUFFIX,3dm.huya.com,REJECT
DOMAIN-SUFFIX,l.web.huya.com,REJECT
DOMAIN-SUFFIX,metric.huya.com,REJECT
DOMAIN-SUFFIX,statwup.huya.com,REJECT
DOMAIN-SUFFIX,udblog.huya.com,REJECT
DOMAIN-SUFFIX,ylog.huya.com,REJECT
# 欢聚时代(虎牙母公司)广告/数据上报
DOMAIN-SUFFIX,hiido.com,REJECT
DOMAIN-SUFFIX,mlog.hiido.com,REJECT
DOMAIN-SUFFIX,ylog.hiido.com,REJECT

# ═══ 开屏广告素材域（msstatic 广告子域，全量 REJECT）═══
DOMAIN,business.msstatic.com,REJECT
DOMAIN,huyafile.msstatic.com,REJECT
DOMAIN,pp-cdnfile2pcdn.msstatic.com,REJECT
DOMAIN,livewebbs2pcdn.msstatic.com,REJECT

# ═══ 腾讯广点通 GDT 广告 SDK（虎牙 APP 广告来源，全局生效=全局去广告）═══
DOMAIN-SUFFIX,gdt.qq.com,REJECT
DOMAIN-SUFFIX,gdtimg.com,REJECT
DOMAIN-SUFFIX,ugdtimg.com,REJECT
DOMAIN-SUFFIX,adsmind.gdtimg.com,REJECT
DOMAIN-SUFFIX,adsmind.apdcdn.tc.qq.com,REJECT
DOMAIN-SUFFIX,pgdt.gtimg.cn,REJECT

# ═══ MediaV 广告 SDK（虎牙另一广告来源）═══
DOMAIN-SUFFIX,mediav.com,REJECT

[Rewrite]
# 开屏/入口广告接口（可解密域，直接 reject）
^https?:\/\/cdn\.wup\.huya\.com\/launch\/queryHttpDns reject
^https?:\/\/business\.msstatic\.com\/advertiser\/material reject
^https?:\/\/cdnfile1\.msstatic\.com\/cdnfile\/appad\/ reject-img

[MITM]
hostname = cdn.wup.huya.com, business.msstatic.com, cdnfile1.msstatic.com
